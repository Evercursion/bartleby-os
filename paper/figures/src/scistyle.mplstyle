# Monochrome scientific figure style for the Paper Machine Workbench.
# Goal: publication-quality, grayscale, serif to match LaTeX body text.
# Distinguish series by linestyle / marker / grayscale, never by hue.

# --- Fonts (match a LaTeX article in Computer Modern / Times) ---
font.family:        serif
font.serif:         DejaVu Serif, Times New Roman, Times, Nimbus Roman
mathtext.fontset:   dejavuserif
font.size:          10
axes.titlesize:     10
axes.labelsize:     10
xtick.labelsize:    9
ytick.labelsize:    9
legend.fontsize:    9

# --- Monochrome: cycle through black with varied linestyles and markers ---
axes.prop_cycle: (cycler('color', ['000000', '000000', '000000', '000000', '555555', '555555']) + cycler('linestyle', ['-', '--', ':', '-.', '-', '--']) + cycler('marker', ['None', 'o', 's', '^', 'D', 'v']))

# --- Lines & markers ---
lines.linewidth:        1.3
lines.markersize:       4
lines.markerfacecolor:  white
lines.markeredgecolor:  black
lines.markeredgewidth:  0.9

# --- Axes / spines ---
axes.edgecolor:     black
axes.linewidth:     0.8
axes.grid:          False
axes.axisbelow:     True
axes.spines.top:    False
axes.spines.right:  False
axes.titleweight:   normal
axes.facecolor:     white
figure.facecolor:   white

# --- Grid (if enabled per-figure) ---
grid.color:         bbbbbb
grid.linestyle:     :
grid.linewidth:     0.5

# --- Ticks ---
xtick.direction:    in
ytick.direction:    in
xtick.color:        black
ytick.color:        black
xtick.major.size:   3.5
ytick.major.size:   3.5
xtick.major.width:  0.8
ytick.major.width:  0.8

# --- Legend ---
legend.frameon:     False
legend.handlelength: 2.4

# --- Figure size & saving (vector PDF for LaTeX) ---
figure.figsize:     3.5, 2.6
figure.dpi:         150
savefig.dpi:        300
savefig.format:     pdf
savefig.bbox:       tight
savefig.pad_inches: 0.02
pdf.fonttype:       42
ps.fonttype:        42
